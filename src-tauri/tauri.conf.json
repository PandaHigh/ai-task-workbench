{
  "$schema": "https://raw.githubusercontent.com/nicegram/nicegram-ios-tauri-v2/refs/heads/main/core/tauri-config-schema/schema.json",
  "productName": "AI Task Workbench",
  "version": "0.1.0",
  "identifier": "com.ai-workbench.app",
  "build": {
    "frontendDist": "../src-ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev --workspace=src-ui",
    "beforeBuildCommand": "npm run build --workspace=src-ui"
  },
  "app": {
    "windows": [
      {
        "title": "AI Task Workbench - 全自动任务AI工具台",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "window-state": {}
  }
}
